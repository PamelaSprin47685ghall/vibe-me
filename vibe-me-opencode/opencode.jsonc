{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "task": "deny"
  },
  "plugin": [
    "/home/kunweiz/Desktop/vibe/vibe-me/vibe-me-opencode/dist/index.js"
  ],
  "agent": {
    "browser": {
      "model": "ollama-cloud/kimi-k2.6"
    },
    "runner": {
      "model": "ollama-cloud/deepseek-v4-flash"
    },
    "editor": {
      "model": "ollama-cloud/glm-5.1"
    },
    "greper": {
      "model": "ollama-cloud/deepseek-v4-flash"
    },
    "reviewer": {
      "model": "ollama-cloud/glm-5.1"
    },
    "reverie": {
      "model": "ollama-cloud/glm-5.1"
    },
    "plan": {
      "disable": true
    },
    "title": {
      "disable": true
    },
    "summary": {
      "disable": true
    },
    "compaction": {
      "model": "ollama-cloud/deepseek-v4-flash"
    }
  },
  "lsp": false,
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 8192
  }
}